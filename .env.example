# CarCom Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase (required for auth & database)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps (required for maps)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Moyasar (required for payments)
# Get these from https://dashboard.moyasar.com/
EXPO_PUBLIC_MOYASAR_TEST_KEY=pk_test_xxxxx
EXPO_PUBLIC_MOYASAR_LIVE_KEY=pk_live_xxxxx
EXPO_PUBLIC_MOYASAR_APPLE_MERCHANT_ID=merchant.com.your.app
EXPO_PUBLIC_MOYASAR_SAMSUNG_SERVICE_ID=your-samsung-service-id

# Set to "production" to use live keys
NODE_ENV=development
